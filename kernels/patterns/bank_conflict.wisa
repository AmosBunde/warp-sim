// One warp: lane i stores then loads shared word 32 i, all in bank 0.
.entry bank_conflict
.param out
.shared 4096
        mov.sreg r0, %laneid
        shl r1, r0, 7               // word 32 i
        st.shared [r1], r0
        ld.shared r3, [r1]
        shl r4, r0, 2
        ld.param r5, [out]
        add r5, r5, r4
        st.global [r5], r3
        exit

// One warp: lane i loads word i and stores it to out[i]. Fully coalesced.
.entry coalesced
.param in
.param out
        mov.sreg r0, %laneid
        shl r1, r0, 2
        ld.param r2, [in]
        add r2, r2, r1
        ld.global r3, [r2]
        ld.param r4, [out]
        add r4, r4, r1
        st.global [r4], r3
        exit

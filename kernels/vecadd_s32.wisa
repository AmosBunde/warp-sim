// Integer vector add: c[i] = a[i] + b[i] (s32, wraps) for i < n.
.entry vecadd_s32
.param a
.param b
.param c
.param n

    mov.sreg r0, %tid.x
    mov.sreg r1, %ctaid.x
    mov.sreg r2, %ntid.x
    mul     r1, r1, r2
    add     r0, r0, r1          // r0 = global index
    ld.param r3, [n]
    setp.ge.s32 p0, r0, r3
@p0 bra done
    shl     r4, r0, 2
    ld.param r5, [a]
    add     r5, r5, r4
    ld.global r6, [r5]
    ld.param r7, [b]
    add     r7, r7, r4
    ld.global r8, [r7]
    add     r6, r6, r8
    ld.param r9, [c]
    add     r9, r9, r4
    st.global [r9], r6
done:
    exit
